<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>GiftShop Admin</title>

  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: 'Inter', sans-serif;
    }

    body {
      background: linear-gradient(135deg, #eef2ff, #f8fafc);
      color: #1e293b;
    }

    header {
      background: white;
      padding: 18px 30px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
    }

    .btn {
      background: linear-gradient(135deg, #6366f1, #4f46e5);
      color: white;
      border: none;
      padding: 8px 16px;
      border-radius: 25px;
      cursor: pointer;
      transition: 0.3s;
    }

    .btn:hover {
      transform: scale(1.05);
    }

    .dashboard {
      display: flex;
      min-height: 100vh;
    }

    .sidebar {
      width: 230px;
      background: #0f172a;
      padding: 25px 15px;
    }

    .sidebar a {
      display: block;
      color: #94a3b8;
      text-decoration: none;
      padding: 12px;
      border-radius: 10px;
      margin-bottom: 10px;
      transition: 0.3s;
    }

    .sidebar a.active,
    .sidebar a:hover {
      background: linear-gradient(135deg, #6366f1, #4f46e5);
      color: white;
    }

    .content {
      flex: 1;
      padding: 35px;
    }

    .section {
      display: none;
      background: white;
      padding: 25px;
      border-radius: 18px;
      margin-bottom: 30px;
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.05);
    }

    .section.active {
      display: block;
    }

    .stats {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 20px;
      margin-bottom: 25px;
    }

    .card {
      background: linear-gradient(135deg, #6366f1, #4f46e5);
      color: white;
      padding: 20px;
      border-radius: 15px;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 15px;
    }

    th,
    td {
      padding: 12px;
      border-bottom: 1px solid #eee;
      text-align: left;
    }

    th {
      background: #f1f5f9;
    }

    tr:hover {
      background: #f8fafc;
    }

    .badge {
      padding: 5px 10px;
      border-radius: 20px;
      font-size: 12px;
      color: white;
    }

    .Pending {
      background: #f59e0b;
    }

    .Paid {
      background: #3b82f6;
    }

    .Shipped {
      background: #6366f1;
    }

    .Delivered {
      background: #10b981;
    }

    .Cancelled {
      background: #ef4444;
    }

    .low {
      color: red;
      font-weight: 600;
    }

    .modal {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.4);
      justify-content: center;
      align-items: center;
    }

    .modal-content {
      background: white;
      padding: 25px;
      border-radius: 20px;
      width: 400px;
      position: relative;
    }

    input,
    select {
      width: 100%;
      padding: 8px;
      margin-bottom: 10px;
      border-radius: 8px;
      border: 1px solid #ddd;
    }

    .close {
      position: absolute;
      top: 10px;
      right: 15px;
      cursor: pointer;
    }
  </style>
</head>

<body>

  <header>
    <h1>🎁 GiftShop Admin</h1>
    <button class="btn" onclick="logout()">Logout</button>
  </header>

  <div class="dashboard">

    <div class="sidebar">
      <a onclick="showSection('overview')" class="active">Dashboard</a>
      <a onclick="showSection('products')">Products</a>
      <a onclick="showSection('orders')">Orders</a>
      <a onclick="showSection('customers')">Customers</a>
      <a onclick="showSection('coupons')">Coupons</a>
    </div>

    <div class="content">

      <!-- OVERVIEW -->
      <section id="overview" class="section active">
        <h2>Dashboard Overview</h2>
        <div class="stats">
          <div class="card">Orders<h3 id="totalOrders">0</h3>
          </div>
          <div class="card">Revenue<h3 id="totalRevenue">$0</h3>
          </div>
          <div class="card">Customers<h3 id="totalCustomers">0</h3>
          </div>
          <div class="card">Products<h3 id="totalProducts">0</h3>
          </div>
        </div>
        <canvas id="chart"></canvas>
      </section>

      <!-- PRODUCTS -->
      <section id="products" class="section">
        <div style="display:flex;justify-content:space-between;align-items:center;">
          <h2>Products</h2>
          <button class="btn" onclick="openModal()">+ Add Product</button>
        </div>
        <table>
          <thead>
            <tr>
              <th>Name</th>
              <th>Price</th>
              <th>Category</th>
              <th>Stock</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody id="productTable"></tbody>
        </table>
      </section>

      <!-- ORDERS -->
      <section id="orders" class="section">
        <h2>Orders</h2>
        <table>
          <thead>
            <tr>
              <th>Customer</th>
              <th>Total</th>
              <th>Address</th>
              <th>Status</th>
              <th>Update</th>
            </tr>

          </thead>
          <tbody id="orderTable"></tbody>
        </table>
      </section>

      <!-- CUSTOMERS -->
      <section id="customers" class="section">
        <h2>Customers</h2>

        <table>
          <thead>
            <tr>
              <th>Name</th>
              <th>Email</th>
              <th>Orders</th>
              <th>Total Spent</th>
              <th>Status</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody id="customerTable"></tbody>
        </table>
      </section>

      <!-- COUPONS -->
      <section id="coupons" class="section">
        <div style="display:flex;justify-content:space-between;align-items:center;">
          <h2>Coupons</h2>
          <button class="btn" onclick="openCouponModal()">+ Add Coupon</button>
        </div>

        <table>
          <thead>
            <tr>
              <th>Code</th>
              <th>Type</th>
              <th>Discount</th>
              <th>Min Order</th>
              <th>Expiry</th>
              <th>Used</th>
              <th>Status</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody id="couponTable"></tbody>
        </table>
      </section>


    </div>
  </div>

  <div class="modal" id="customerModal">
    <div class="modal-content">
      <span class="close" onclick="closeCustomerModal()">✖</span>
      <h3>Customer Details</h3>

      <div id="customerDetails"></div>

      <h4 style="margin-top:15px;">Orders</h4>
      <div id="customerOrders"></div>

    
    </div>
  </div>

  <div class="modal" id="couponModal">
<div class="modal-content">
<span class="close" onclick="closeCouponModal()">✖</span>
<h3>Add Coupon</h3>

<input type="text" id="couponCode" placeholder="Code (e.g. SAVE10)">
<select id="couponType">
  <option value="percent">Percentage</option>
  <option value="fixed">Fixed Amount</option>
</select>
<input type="number" id="couponDiscount" placeholder="Discount">
<input type="number" id="couponMinOrder" placeholder="Minimum Order">
<input type="date" id="couponExpiry">
<input type="number" id="couponLimit" placeholder="Usage Limit">

<button class="btn" onclick="saveCoupon()">Save Coupon</button>
</div>
</div>


  <!-- PRODUCT MODAL -->
  <div class="modal" id="productModal">
    <div class="modal-content">
      <span class="close" onclick="closeModal()">✖</span>
      <h3 id="modalTitle">Add Product</h3>
      <input type="hidden" id="productId">
      <input type="text" id="name" placeholder="Product Name">
      <input type="number" id="price" placeholder="Price">
      <select id="category">
        <option value="">-- Select Category --</option>
        <option value="birthday">Birthday</option>
        <option value="couple">Couple</option>
        <option value="baby">Baby</option>
        <option value="corporate">Corporate</option>
      </select>
      <input type="number" id="stock" placeholder="Stock">
      <input type="file" id="imageFile" accept="image/*">
      <button class="btn" onclick="saveProduct()">Save</button>
    </div>
  </div>

  <script>
    function showSection(id) {
      document.querySelectorAll('.section').forEach(s => s.classList.remove('active'));
      document.getElementById(id).classList.add('active');
      document.querySelectorAll('.sidebar a').forEach(a => a.classList.remove('active'));
      event.target.classList.add('active');
    }

    function openModal(edit = false, product = null) {
      document.getElementById("productModal").style.display = "flex";
      if (edit) {
        document.getElementById("modalTitle").innerText = "Edit Product";
        document.getElementById("productId").value = product._id;
        document.getElementById("name").value = product.name;
        document.getElementById("price").value = product.price;
        document.getElementById("stock").value = product.stock;
        document.getElementById("category").value = product.category || "";
        // cannot set file input value for security; keep existing image as-is
      } else {
        document.getElementById("modalTitle").innerText = "Add Product";
        document.getElementById("productId").value = "";
        document.querySelectorAll("#name,#price,#stock,#category").forEach(i => i.value = "");
        const fileInput = document.getElementById('imageFile'); if(fileInput) fileInput.value = '';
      }
    }

    function closeModal() {
      document.getElementById("productModal").style.display = "none";
    }

    async function saveProduct() {

      const id = document.getElementById("productId").value;

      const formData = new FormData();
      formData.append("name", document.getElementById("name").value);
      formData.append("price", document.getElementById("price").value);
      formData.append("stock", document.getElementById("stock").value);
      formData.append("category", document.getElementById("category").value || "");

      const file = document.getElementById("imageFile").files[0];
      if (file) {
        formData.append("image", file);
      }

      let url = id ? `/admin/products/${id}` : "/admin/products";
      let method = id ? "PUT" : "POST";

      try {
        const response = await fetch(url, {
          method: method,
          body: formData
        });
        
        if(!response.ok) {
          const error = await response.json();
          alert("Error: " + (error.error || "Failed to save product"));
          return;
        }

        closeModal();
        loadDashboard();
      } catch(err) {
        console.error("Error saving product:", err);
        alert("Failed to save product");
      }
    }


    async function deleteProduct(id) {
      if (confirm("Delete this product?")) {
        try {
          const response = await fetch(`/admin/products/${id}`, { method: "DELETE" });
          if(!response.ok) {
            const error = await response.json();
            alert("Error: " + (error.error || "Failed to delete product"));
            return;
          }
          loadDashboard();
        } catch(err) {
          console.error("Error deleting product:", err);
          alert("Failed to delete product");
        }
      }
    }

    async function updateStatus(id, status) {
      try {
        const response = await fetch(`/admin/orders/${id}/status`, {
          method: "PUT",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ status })
        });
        if(!response.ok) {
          const error = await response.json();
          alert("Error: " + (error.error || "Failed to update status"));
          return;
        }
        loadDashboard();
      } catch(err) {
        console.error("Error updating status:", err);
        alert("Failed to update status");
      }
    }

    function logout() { window.location.href = "/admin/logout"; }

    async function loadDashboard() {
      try {
        const dataResponse = await fetch("/admin/dashboard-data");
        if(!dataResponse.ok) throw new Error("Failed to fetch dashboard data");
        const data = await dataResponse.json();
        
        const analyticsResponse = await fetch("/admin/analytics");
        if(!analyticsResponse.ok) throw new Error("Failed to fetch analytics");
        const analytics = await analyticsResponse.json();

        totalOrders.innerText = data.orders ? data.orders.length : 0;
        totalCustomers.innerText = data.customers ? data.customers.length : 0;
        totalProducts.innerText = data.products ? data.products.length : 0;
        totalRevenue.innerText = "$" + (analytics.totalRevenue || 0);

        productTable.innerHTML = "";
        if(data.products) {
          data.products.forEach(p => {
            productTable.innerHTML += `
          <tr>
            <td>${p.name}</td>
            <td>$${p.price}</td>
            <td>${p.category || ''}</td>
            <td class="${p.stock < 5 ? 'low' : ''}">${p.stock}</td>
            <td>
              <button onclick='openModal(true,${JSON.stringify(p)})'>Edit</button>
              <button onclick='deleteProduct("${p._id}")'>Delete</button>
            </td>
          </tr>`;
          });
        }

        orderTable.innerHTML = "";
        if(data.orders) {
          data.orders.forEach(o => {
            const addr = o.shippingAddress || {};
            orderTable.innerHTML += `
        <tr>
          <td>${o.customer ? o.customer.name : "Guest"}</td>
          <td>$${o.total || 0}</td>
          <td>
            ${addr.fullName || "N/A"}<br>
            ${addr.address || ""}, ${addr.city || ""}<br>
            ${addr.state || ""} - ${addr.postalCode || ""}<br>
            📞 ${addr.phone || ""}
          </td>
          <td><span class="badge ${o.status}">${o.status}</span></td>
          <td>
            <select onchange="updateStatus('${o._id}',this.value)">
              <option ${o.status === "Pending" ? "selected" : ""}>Pending</option>
              <option ${o.status === "Paid" ? "selected" : ""}>Paid</option>
              <option ${o.status === "Shipped" ? "selected" : ""}>Shipped</option>
              <option ${o.status === "Delivered" ? "selected" : ""}>Delivered</option>
              <option ${o.status === "Cancelled" ? "selected" : ""}>Cancelled</option>
            </select>
          </td>
        </tr>
      `;
          });
        }
        customerTable.innerHTML = "";
        if(data.customers) {
          data.customers.forEach(c => {
            const orders = data.orders ? data.orders.filter(o => o.customer && o.customer._id === c._id) : [];
            const totalOrders = orders.length;
            const totalSpent = orders.reduce((sum, o) => sum + (o.total || 0), 0);
            const lastOrder = orders.length
              ? new Date(orders[orders.length - 1].createdAt).toLocaleDateString()
              : "No Orders";

            customerTable.innerHTML += `
        <tr>
          <td>${c.name}</td>
          <td>${c.email}</td>
          <td>${totalOrders}</td>
          <td>$${totalSpent}</td>
          <td style="color:${c.isBlocked ? 'red' : 'green'}">
            ${c.isBlocked ? "Blocked" : "Active"}
          </td>
          <td>
            <button onclick='viewCustomer(${JSON.stringify(c)},${JSON.stringify(orders)})'>
              View
            </button>
            <button onclick="toggleBlock('${c._id}',${c.isBlocked})">
              ${c.isBlocked ? "Unblock" : "Block"}
            </button>
            <button onclick="deleteCustomer('${c._id}','${c.name}')">
              Delete
            </button>
          </td>
        </tr>
      `;
          });
        }

        couponTable.innerHTML = "";
        if(data.coupons) {
          data.coupons.forEach(c => {
            const expired = new Date(c.expiry) < new Date();
            couponTable.innerHTML += `
          <tr>
            <td>${c.code}</td>
            <td>${c.type}</td>
            <td>${c.type==="percent"?c.discount+"%":"$"+c.discount}</td>
            <td>$${c.minOrder}</td>
            <td>${new Date(c.expiry).toLocaleDateString()}</td>
            <td>${c.usedCount}/${c.usageLimit}</td>
            <td style="color:${c.active?'green':'red'}">
              ${expired?"Expired":(c.active?"Active":"Inactive")}
            </td>
            <td>
              <button onclick="toggleCoupon('${c._id}')">Toggle</button>
              <button onclick="deleteCoupon('${c._id}')">Delete</button>
            </td>
          </tr>
        `;
          });
        }

        // Only render chart if monthlyRevenue has data
        const chartCanvas = document.getElementById("chart");
        if(chartCanvas && Object.keys(analytics.monthlyRevenue || {}).length > 0) {
          // Destroy previous chart instance if it exists
          if(chartCanvas.chart) {
            chartCanvas.chart.destroy();
          }
          chartCanvas.chart = new Chart(chartCanvas, {
            type: "line",
            data: {
              labels: Object.keys(analytics.monthlyRevenue),
              datasets: [{
                data: Object.values(analytics.monthlyRevenue),
                borderColor: "#4f46e5",
                backgroundColor: "rgba(79,70,229,0.2)",
                fill: true
              }]
            },
            options: { plugins: { legend: { display: false } } }
          });
        }
      } catch(err) {
        console.error("Error loading dashboard:", err);
        alert("Failed to load dashboard data");
      }
    }

    function openCouponModal(){
  document.getElementById("couponModal").style.display="flex";
}

function closeCouponModal(){
  document.getElementById("couponModal").style.display="none";
}

async function loadCoupons(){
  const coupons = await fetch("/admin/coupons").then(r=>r.json());

  couponTable.innerHTML="";

  coupons.forEach(c=>{
    const expired = new Date(c.expiry) < new Date();

    couponTable.innerHTML+=`
      <tr>
        <td>${c.code}</td>
        <td>${c.type}</td>
        <td>${c.type==="percent"?c.discount+"%":"$"+c.discount}</td>
        <td>$${c.minOrder}</td>
        <td>${new Date(c.expiry).toLocaleDateString()}</td>
        <td>${c.usedCount}/${c.usageLimit}</td>
        <td style="color:${c.active?'green':'red'}">
          ${expired?"Expired":(c.active?"Active":"Inactive")}
        </td>
        <td>
          <button onclick="toggleCoupon('${c._id}')">Toggle</button>
          <button onclick="deleteCoupon('${c._id}')">Delete</button>
        </td>
      </tr>
    `;
  });
}

async function saveCoupon(){

  const coupon={
    code:document.getElementById("couponCode").value.toUpperCase(),
    type:document.getElementById("couponType").value,
    discount:Number(document.getElementById("couponDiscount").value),
    minOrder:Number(document.getElementById("couponMinOrder").value),
    expiry:document.getElementById("couponExpiry").value,
    usageLimit:Number(document.getElementById("couponLimit").value)
  };

  try {
    const response = await fetch("/admin/coupons",{
      method:"POST",
      headers:{"Content-Type":"application/json"},
      body:JSON.stringify(coupon)
    });
    
    if(!response.ok) {
      const error = await response.json();
      alert("Error: " + (error.error || "Failed to save coupon"));
      return;
    }

    closeCouponModal();
    loadCoupons();
  } catch(err) {
    console.error("Error saving coupon:", err);
    alert("Failed to save coupon");
  }
}

async function toggleCoupon(id){
  try {
    const response = await fetch(`/admin/coupons/${id}/toggle`,{method:"PUT"});
    if(!response.ok) {
      const error = await response.json();
      alert("Error: " + (error.error || "Failed to toggle coupon"));
      return;
    }
    loadCoupons();
  } catch(err) {
    console.error("Error toggling coupon:", err);
    alert("Failed to toggle coupon");
  }
}

async function deleteCoupon(id){
  if(confirm("Delete this coupon?")){
    try {
      const response = await fetch(`/admin/coupons/${id}`,{method:"DELETE"});
      if(!response.ok) {
        const error = await response.json();
        alert("Error: " + (error.error || "Failed to delete coupon"));
        return;
      }
      loadCoupons();
    } catch(err) {
      console.error("Error deleting coupon:", err);
      alert("Failed to delete coupon");
    }
  }
}

async function deleteCoupon(id){
  if(confirm("Delete this coupon?")){
    await fetch(`/admin/coupons/${id}`,{method:"DELETE"});
    loadCoupons();
  }
}

loadCoupons();

// Customer Management Functions
function viewCustomer(customer, orders) {
  const detailsHtml = `
    <p><strong>Name:</strong> ${customer.name}</p>
    <p><strong>Email:</strong> ${customer.email}</p>
    <p><strong>Username:</strong> ${customer.username}</p>
    <p><strong>Status:</strong> <span style="color:${customer.isBlocked ? 'red' : 'green'}">${customer.isBlocked ? 'Blocked' : 'Active'}</span></p>
    <p><strong>Joined:</strong> ${new Date(customer.createdAt).toLocaleDateString()}</p>
  `;
  
  const ordersHtml = orders.length > 0 ? `
    <table style="width:100%;border-collapse:collapse;">
      <tr style="background:#f0f0f0;">
        <th style="padding:8px;border:1px solid #ddd;">Order ID</th>
        <th style="padding:8px;border:1px solid #ddd;">Amount</th>
        <th style="padding:8px;border:1px solid #ddd;">Status</th>
        <th style="padding:8px;border:1px solid #ddd;">Date</th>
      </tr>
      ${orders.map(o => `
        <tr>
          <td style="padding:8px;border:1px solid #ddd;">${o._id.substring(0,8)}...</td>
          <td style="padding:8px;border:1px solid #ddd;">$${o.total || 0}</td>
          <td style="padding:8px;border:1px solid #ddd;">${o.status}</td>
          <td style="padding:8px;border:1px solid #ddd;">${new Date(o.createdAt).toLocaleDateString()}</td>
        </tr>
      `).join('')}
    </table>
  ` : `<p style="color:#999;">No orders yet</p>`;
  
  document.getElementById("customerDetails").innerHTML = detailsHtml;
  document.getElementById("customerOrders").innerHTML = ordersHtml;
  document.getElementById("customerModal").style.display = "flex";
}

function closeCustomerModal() {
  document.getElementById("customerModal").style.display = "none";
}

async function toggleBlock(customerId, isCurrentlyBlocked) {
  if(confirm(`${isCurrentlyBlocked ? 'Unblock' : 'Block'} this customer?`)) {
    try {
      const response = await fetch(`/admin/customers/${customerId}/block`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ isBlocked: !isCurrentlyBlocked })
      });
      
      if(!response.ok) {
        const error = await response.json();
        alert("Error: " + (error.error || "Failed to update customer status"));
        return;
      }
      
      loadDashboard();
    } catch(err) {
      console.error("Error updating customer:", err);
      alert("Failed to update customer status");
    }
  }
}

async function deleteCustomer(customerId, customerName) {
  if(confirm(`Are you sure you want to delete ${customerName}? This action cannot be undone.`)) {
    try {
      const response = await fetch(`/admin/customers/${customerId}`, {
        method: 'DELETE',
        headers: { 'Content-Type': 'application/json' }
      });
      
      if(!response.ok) {
        const error = await response.json();
        alert("Error: " + (error.error || "Failed to delete customer"));
        return;
      }
      
      loadDashboard();
    } catch(err) {
      console.error("Error deleting customer:", err);
      alert("Failed to delete customer");
    }
  }
}

    loadDashboard();
  </script>

</body>

</html>